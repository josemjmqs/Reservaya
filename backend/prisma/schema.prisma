generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  STAFF
}

model Business {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  timezone  String      @default("America/Santiago")
  phone     String?
  createdAt DateTime    @default(now())
  members   Member[]
  services  Service[]
  customers Customer[]
  bookings  Booking[]
  blocks    TimeBlock[]
}

model User {
  id              String                   @id @default(cuid())
  email           String                   @unique
  name            String
  password        String
  emailVerifiedAt DateTime?
  createdAt       DateTime                 @default(now())
  members         Member[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
}

model Member {
  id                String          @id @default(cuid())
  role              MemberRole
  bookable          Boolean         @default(true)
  active            Boolean         @default(true)
  // Recibe un correo por cada reserva nueva hecha desde la página pública
  notifyNewBookings Boolean         @default(true)
  displayName       String
  userId            String?
  businessId        String
  user              User?           @relation(fields: [userId], references: [id])
  business          Business        @relation(fields: [businessId], references: [id])
  hours             WorkingHours[]
  bookings          Booking[]
  services          MemberService[]

  @@unique([userId, businessId])
  @@index([businessId])
}

model MemberService {
  memberId  String
  serviceId String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([memberId, serviceId])
}

model Service {
  id           String          @id @default(cuid())
  name         String
  description  String?
  durationMin  Int
  totalMin     Int?
  price        Int?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id])
  bookingItems BookingItem[]
  members      MemberService[]
  category     String?
  imageKey     String? // ruta de la foto en el bucket; la URL pública se arma con R2_PUBLIC_URL

  @@index([businessId])
}

model WorkingHours {
  id       String @id @default(cuid())
  weekday  Int // 0 = domingo ... 6 = sábado
  opensAt  String // "09:00"
  closesAt String // "18:00"
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, weekday])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  createdAt  DateTime  @default(now())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  bookings   Booking[]

  @@unique([businessId, email])
}

model Booking {
  id          String        @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  manageToken String        @unique @default(cuid())
  createdAt   DateTime      @default(now())
  businessId  String
  memberId    String
  customerId  String
  business    Business      @relation(fields: [businessId], references: [id])
  member      Member        @relation(fields: [memberId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       BookingItem[]

  @@index([businessId, startsAt])
  @@index([memberId, startsAt])
}

// Servicios de una reserva, en el orden en que se hacen (position 0, 1, ...)
model BookingItem {
  bookingId String
  serviceId String
  position  Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([bookingId, position])
  @@unique([bookingId, serviceId])
  @@index([serviceId])
}

model TimeBlock {
  id         String   @id @default(cuid())
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  businessId String
  memberId   String?
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, startsAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
